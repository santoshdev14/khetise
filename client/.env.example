# Kheti Se Configuration

# 1. Google Sheets CSV Publish URL (File -> Share -> Publish to web -> CSV)
# Example: https://docs.google.com/spreadsheets/d/e/2PACX-1vQ.../pub?output=csv
VITE_GOOGLE_SHEET_CSV_URL=

# OR 2. Google Sheet ID (Anyone with the link can view)
# Example: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
VITE_GOOGLE_SHEET_ID=

# 3. WhatsApp Business Phone Number (with country code, no +, no spaces)
VITE_WHATSAPP_NUMBER=919876543210
